# Google Gemini Settings
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
# Comma-separated list of multiple API keys for rotation (e.g. key1,key2,key3)
GEMINI_API_KEYS=your_key1,your_key2
GEMINI_MODEL=gemini-2.5-flash


# Local Embedding Model (runs on-device via SentenceTransformers — no API calls)
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Server Config
HOST=0.0.0.0
PORT=8000

# Directory settings
CHROMA_DB_DIR=data/chroma
PORTFOLIO_JSON_PATH=portfolio.json
